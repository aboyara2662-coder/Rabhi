{
  // Cloudflare Workers: ملفات الموقع في public/، وsrc/index.js يحوّل الروابط الثانية إلى coachrabhi.com
  "name": "rabhi",
  "main": "src/index.js",
  "compatibility_date": "2025-09-01",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "routes": [
    { "pattern": "coachrabhi.com", "custom_domain": true },
    { "pattern": "www.coachrabhi.com", "custom_domain": true }
  ]
}
